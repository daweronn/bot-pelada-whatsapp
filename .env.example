# ===== Evolution API =====
# URL base da sua Evolution API (sem barra no final)
EVOLUTION_BASE_URL=http://localhost:8080
# Nome da instância criada na Evolution
EVOLUTION_INSTANCE=pelada
# API key (a global da Evolution ou a apikey da instância)
EVOLUTION_API_KEY=troque-aqui

# ===== Bot =====
# Números (com DDI+DDD, só dígitos) que PODEM cadastrar jogadores.
# Separe por vírgula. Ex.: 5511999999999,5511888888888
ADMIN_NUMBERS=5511999999999

# (Opcional) Restringe o bot a atuar somente neste grupo (JID do grupo, termina com @g.us).
# Deixe em branco para responder em qualquer conversa.
ALLOWED_GROUP_JID=

# (Opcional) Token simples pra validar o webhook. Se preenchido, a Evolution
# precisa chamar /webhook?token=ESSE_VALOR
WEBHOOK_TOKEN=

# Caminho do banco SQLite
DB_PATH=pelada.db
