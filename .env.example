# ===== Banco (Supabase / Postgres) =====
# Supabase -> Settings -> Database -> Connection string -> Transaction pooler
# Ex.: postgresql://postgres.<ref>:<senha>@<host>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
DATABASE_POOL_MAX=5

# ===== Evolution API =====
EVOLUTION_BASE_URL=https://sua-evolution.exemplo.com
EVOLUTION_INSTANCE=Skorpion
EVOLUTION_API_KEY=troque-aqui

# ===== Bot =====
# Nota inicial de quem entra pelo .vou sem cadastro.
DEFAULT_OVERALL=5

# (Opcional) Token do webhook. Se preenchido, a Evolution precisa chamar
# /webhook?token=ESSE_VALOR
WEBHOOK_TOKEN=

# (Opcional) Loga o payload inteiro dos comandos. Só para diagnóstico.
DEBUG_PAYLOAD=

# Os grupos atendidos e seus admins ficam no banco (pelada.grupos e
# pelada.admins), não aqui: um número atende N grupos.
