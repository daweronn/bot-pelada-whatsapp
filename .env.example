# ===== Banco (Supabase / Postgres) =====
# Supabase -> Settings -> Database -> Connection string -> Transaction pooler
# Ex.: postgresql://postgres.<ref>:<senha>@<host>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
DATABASE_POOL_MAX=5

# ===== Evolution API =====
EVOLUTION_BASE_URL=https://sua-evolution.exemplo.com
EVOLUTION_INSTANCE=Skorpion
EVOLUTION_API_KEY=troque-aqui

# ===== Bot =====
# Nota inicial de quem entra pelo .vou sem cadastro.
DEFAULT_OVERALL=5

# (Obrigatório) Token do webhook: sem ele o bot não sobe. A Evolution precisa
# chamar /webhook?token=ESSE_VALOR
WEBHOOK_TOKEN=

# (Opcional) Loga o payload inteiro dos comandos. Só para diagnóstico.
DEBUG_PAYLOAD=

# ===== Fila de mensagens (notícias do dashboard/.noticia) =====
# Pausa aleatória entre um envio e o próximo, em segundos (evita rajada e ban).
FILA_INTERVALO_MIN_S=8
FILA_INTERVALO_MAX_S=20
# Com a fila vazia, de quanto em quanto tempo (s) ela é consultada de novo.
FILA_OCIOSA_S=10
# Tentativas por grupo antes de desistir do envio e marcá-lo como erro.
FILA_MAX_TENTATIVAS=4
# Recuo após falha: base * 4^(tentativa-1) segundos (30s, 2min, 8min...).
FILA_ESPERA_BASE_S=30
# Por quantos segundos um envio reservado fica travado para outra instância.
FILA_LEASE_S=120

# Os grupos atendidos e seus admins ficam no banco (pelada.grupos e
# pelada.admins), não aqui: um número atende N grupos.
